# Copy to `.env` and choose your own password (minimum 8 characters).
# Used by docker-compose.yml and read by the codeatlas CLI.
CODEATLAS_NEO4J_PASSWORD=
CODEATLAS_NEO4J_URI=bolt://localhost:7687
CODEATLAS_NEO4J_USER=neo4j
CODEATLAS_NEO4J_DATABASE=neo4j

# Optional port overrides for docker-compose.
# CODEATLAS_NEO4J_HTTP_PORT=7474
# CODEATLAS_NEO4J_BOLT_PORT=7687
